{
  "name": "webguard-security-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/serve.ts --dev",
    "build": "next build --webpack && node scripts/verify-client-boundary.mjs",
    "start": "tsx scripts/serve.ts",
    "security:unblock": "tsx --env-file=.env.migration.local scripts/unblock-ip.ts",
    "test": "tsx --test tests/security.test.ts tests/i18n.test.ts tests/inspection.test.ts tests/web-assessment.test.ts tests/ingress.test.ts tests/access.test.ts tests/tunnel.test.ts tests/deployment.test.ts tests/phase2.test.ts tests/file-inspection.test.ts tests/phase2-fixtures.test.ts tests/endpoint-compatibility.test.ts tests/mobile-fixtures.test.ts",
    "fixtures:mobile": "tsx scripts/generate-mobile-review-fixtures.ts",
    "test:mobile:fixtures": "tsx --test tests/mobile-fixtures.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.migration.local scripts/migrate.ts",
    "user:create": "tsx --env-file=.env.migration.local scripts/create-user.ts",
    "user:password": "tsx --env-file=.env.migration.local scripts/reset-password.ts",
    "user:password:production": "tsx --env-file=.env.migration.production.local scripts/reset-password.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:integration": "tsx scripts/integration.ts",
    "db:grant": "tsx --env-file=.env.migration.local scripts/grant-runtime.ts",
    "test:locale": "tsx scripts/locale-smoke.ts",
    "share": "tsx scripts/share.ts",
    "user:create:production": "tsx --env-file=.env.migration.production.local scripts/create-user.ts",
    "db:grant:production": "tsx --env-file=.env.migration.production.local scripts/grant-runtime.ts",
    "db:copy:production": "tsx --env-file=.env.local --env-file=.env.migration.production.local scripts/copy-production-data.ts",
    "db:setup:production": "tsx --env-file=.env.migration.production.local scripts/setup-production.ts",
    "db:migrate:production": "tsx --env-file=.env.migration.production.local scripts/migrate.ts",
    "db:archive": "tsx --env-file=.env.migration.local scripts/archive-diagnostics.ts",
    "db:archive:production": "tsx --env-file=.env.migration.production.local scripts/archive-diagnostics.ts"
  },
  "dependencies": {
    "@emotion/cache": "11.14",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.0",
    "@mui/material-nextjs": "^7.3.10",
    "@next/env": "16.4.2",
    "@prisma/ppg": "1.0.1",
    "@vercel/functions": "3.10.1",
    "ipaddr.js": "^2.2.0",
    "next": "^16.0.0",
    "openai": "^6.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
