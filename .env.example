# Copy to .env.local; fill secrets only on your own machine.
APP_ORIGIN=http://localhost:3000
# Exact additional HTTPS entry addresses for other devices; no wildcard or paths.
APP_ADDITIONAL_ORIGINS=
# Optional: false disables self-registration. The PC sharing launcher forces false.
PUBLIC_REGISTRATION_ENABLED=true
PROJECT_DATABASE=webguard_hub_dev
PROJECT_RUNTIME_ROLE=webguard_hub_dev_app
DATABASE_URL=postgresql://webguard_hub_dev_app:REPLACE_LOCALLY@localhost:5432/webguard_hub_dev
ALLOWED_SCAN_HOSTS=
# public permits user-declared authorized public domains; approved restores a strict list.
SCAN_TARGET_POLICY=public
# Leave empty for direct connections. A trusted proxy must overwrite both identity headers.
TRUSTED_PROXY_IPS=
WEBGUARD_PROXY_SECRET=
AI_ENABLED=false
AI_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenAI is used only when AI_PROVIDER=openai is explicitly selected.
OPENAI_API_KEY=
DEFAULT_LOCALE=en
GEOIP_COUNTRY_HEADER=cf-ipcountry
GEOIP_PROXY_SECRET=
# Optional Docker setup only.
POSTGRES_PASSWORD=
