# Copy to .env.local; keep outside OneDrive for production secrets.
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://webguard:REPLACE_LOCALLY@127.0.0.1:5432/webguard
# Never use the PostgreSQL owner/superuser for the application in production.
ALLOWED_SCAN_HOSTS=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ENABLED=false
# Docker only. Generate locally, never commit.
POSTGRES_PASSWORD=
# Used by user:create only; remove after creation.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ROLE=admin
