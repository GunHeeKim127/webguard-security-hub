# Vercel Production: the integration-provided DATABASE_URL must use pooled.db.prisma.io.
APP_ORIGIN=https://webguard-security-hub.vercel.app
DATABASE_PROVIDER=prisma-postgres
PROJECT_DATABASE=postgres
DATABASE_URL=postgres://PROVIDER_USER:PROVIDER_PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=verify-full
PUBLIC_REGISTRATION_ENABLED=true
SCAN_TARGET_POLICY=public
AI_ENABLED=false
DEFAULT_LOCALE=ko
# PROJECT_RUNTIME_ROLE is not used in this provider-managed profile.
# DIRECT_URL or MIGRATION_DATABASE_URL belongs only on the local migration machine.
