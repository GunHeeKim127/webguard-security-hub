# Copy to .env.migration.production.local on your PC. This file is NOT uploaded to Vercel.
# Use a new dedicated WebGuard cloud database/project, not another application's DB.
PROJECT_DATABASE=neondb
PROJECT_RUNTIME_ROLE=webguard_hub_prod_app
MIGRATION_DATABASE_URL=postgresql://neondb_owner:REPLACE_LOCALLY@YOUR-DIRECT-HOST/neondb?sslmode=verify-full
# Optional pooled host for the generated runtime DATABASE_URL. No protocol or path.
CLOUD_RUNTIME_HOST=
