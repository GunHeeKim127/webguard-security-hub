# Vercel > project > Settings > Environment Variables > Production.
# Replace only DATABASE_URL with the dedicated runtime URL generated by setup-production.
APP_ORIGIN=https://webguard-security-hub.vercel.app
PROJECT_DATABASE=neondb
PROJECT_RUNTIME_ROLE=webguard_hub_prod_app
DATABASE_URL=postgresql://webguard_hub_prod_app:REPLACE_LOCALLY@YOUR-POOLED-HOST/neondb?sslmode=verify-full
PUBLIC_REGISTRATION_ENABLED=false
SCAN_TARGET_POLICY=public
AI_ENABLED=false
DEFAULT_LOCALE=ko
# Optional AI keys belong only in Vercel secrets, never NEXT_PUBLIC_ variables.
AI_PROVIDER=auto
OPENAI_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
